# Tokenoskobi / Coinoskobi panel Nginx template
# Server: Netcup
# Purpose: expose active static panel safely through domain with reverse proxy
# Replace DOMAIN_NAME before installing.

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN_NAME;

    # Certbot may replace this block with HTTPS redirect after SSL issue.

    location / {
        proxy_pass http://127.0.0.1:8096/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }

    location = /healthz {
        access_log off;
        return 200 'ok\n';
        add_header Content-Type text/plain;
    }
}
