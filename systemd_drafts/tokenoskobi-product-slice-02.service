[Unit]
Description=Tokenoskobi Product Slice 03 Human Decision History
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/tokenoskobi_clean_v1
ExecStart=/usr/bin/python3 /root/tokenoskobi_clean_v1/tools/tokenoskobi_product_slice_03_runtime.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/tokenoskobi_clean_v1
RuntimeDirectory=tokenoskobi-product-slice-02
RuntimeDirectoryMode=0700
StateDirectory=tokenoskobi-product-slice-03
StateDirectoryMode=0700
Environment=TOKENOSKOBI_GT_RATE_DIR=/run/tokenoskobi-product-slice-02
Environment=TOKENOSKOBI_SLICE03_STATE_DIR=/var/lib/tokenoskobi-product-slice-03
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
