  "source_selection_criteria": "data/control/era40_dataset_selection_criteria_contract_noapi_v1.json",
  "purpose": "Define how selected historical news replay cases must be split into visible estimator input and hidden outcome package before any real replay is attempted.",
  "scope_rule": "Preparation contract only. No live feed pull, no runtime patch, no external API, no DB/schema/systemd change, no product-specific code.",
  "split_model": {
    "visible_input_package": {
      "purpose": "Estimator sees only information available at or before event time.",
      "allowed_fields": [
        "case_id",
        "correlation_id",
        "event_time_utc_or_best_available_time",
        "visible_news_text_or_summary",
        "source_class_or_source_ref",
        "available_identity_context_at_event_time",
        "available_market_or_system_context_at_event_time",
        "missing_evidence_at_event_time"
      ],
      "forbidden_fields": [
        "later_price_move",
        "later_liquidity_move",
        "later_onchain_result",
        "later_confirmation_result",
        "future_label",
        "final_score",
        "post_event_human_note",
        "outcome_summary"
      ]
    },
    "hidden_outcome_package": {
      "purpose": "Stored separately until estimate is sealed.",
      "allowed_fields": [
        "case_id",
        "correlation_id",
        "outcome_ref",
        "outcome_window",
        "later_market_move",
        "later_liquidity_move",
        "later_onchain_context",
        "later_confirmation_context",
        "later_classification_label",
        "outcome_source_ref"
      ],
      "visibility_rule": "Hidden outcome package must remain inaccessible to estimator before estimate seal."
    }
  },
  "masking_process": [
    "load_candidate_case",
    "derive_visible_input_package",
    "derive_hidden_outcome_package",
    "run_leakage_check",
    "assign_masking_status",
    "write_manifest_refs_only",
    "block_replay_if_leakage_detected"
  ],
  "masking_status_values": [
    "MASK_READY",
    "MASK_READY_WITH_MISSING_CONTEXT",
    "MASK_REJECT_OUTCOME_LEAKAGE",
    "MASK_REJECT_NO_VISIBLE_INPUT",
    "MASK_REJECT_NO_EVENT_TIME",
    "MASK_REJECT_NO_OUTCOME_SPLIT",
    "MASK_REVIEW_REQUIRED"
  ],
  "leakage_checks": {
    "required": true,
    "checks": [
      "visible_input_must_not_contain_later_result_terms",
      "visible_input_must_not_contain_final_score_terms",
      "visible_input_must_not_contain_post_event_labels",
      "hidden_outcome_ref_must_be_separate",
      "estimate_seal_required_before_outcome_reveal"
    ],
    "failure_behavior": "Reject or quarantine case before replay; do not allow estimator access."
  },
  "manifest_outputs_next": [
    "selected_case_manifest",
    "masked_input_manifest",
    "hidden_outcome_manifest",
    "leakage_check_report",
    "pre_replay_audit_report"
  ],
  "initial_replay_bounds": {
    "minimum_cases": 5,
    "preferred_cases": 20,
    "maximum_cases": 50,
    "reason": "First real historical replay must stay bounded and inspectable."
  },
  "forbidden_work": [
    "live_feed_pull",
    "external_api_call",
    "runtime_patch",
    "db_schema_change",
    "service_change",
    "order_or_wallet_action",
    "outcome_leakage_to_estimator",
    "product_specific_code",
    "root_artifact_creation"
  ],
  "guards": {
