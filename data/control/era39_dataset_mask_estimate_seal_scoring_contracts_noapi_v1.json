    ]
  },
  "feedback_contract": {
    "feedback_is_context_only": true,
    "feedback_does_not_overwrite_estimate": true,
    "feedback_does_not_grant_authority": true,
    "feedback_creates_versioned_learning_context": true
  },
  "forbidden_work": [
