  "purpose": "Define the core contracts for historical blind replay in one package: dataset, outcome mask, estimate output, immutable seal, reveal scoring, and feedback context.",
  "identity": "ERA39_BLIND_REPLAY_CORE_CONTRACTS_V1",
  "scope_rule": "Historical replay contract only. No live pull, runtime patch, external API, schema change, service change, or execution authority.",
  "dataset_contract": {
    "required_case_fields": [
      "replay_case_id",
      "correlation_id",
      "event_time_utc",
      "visible_input",
      "hidden_outcome_ref",
      "dataset_version",
      "mask_version"
    ],
