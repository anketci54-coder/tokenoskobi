    "hidden_until_reveal": [
      "later_market_move",
      "later_liquidity_move",
      "later_onchain_context",
      "later_confirmation_context",
      "later_classification_label"
    ]
  },
  "masking_contract": {
    "outcome_hidden_by_default": true,
    "estimator_must_not_see_hidden_outcome": true,
    "mask_leakage_result": "FAIL_REPLAY_CASE",
    "mask_required_before_estimate": true
  },
  "estimate_output_contract": {
    "required_fields": [
      "replay_case_id",
      "correlation_id",
      "estimate_created_at_utc",
      "context_estimate",
      "confidence_band",
      "expected_effect_window",
      "missing_evidence",
      "review_priority_estimate",
      "authority_absent"
    ],
    "allowed_context_estimates": [
      "NO_ACTION_CONTEXT",
      "OBSERVE_CONTEXT",
      "REVIEW_CONTEXT",
      "ESCALATE_REVIEW_CONTEXT",
      "RISK_CONTEXT",
      "OPPORTUNITY_CONTEXT",
      "MIXED_CONTEXT",
      "UNKNOWN_CONTEXT"
    ]
  },
  "seal_contract": {
    "estimate_must_be_sealed_before_reveal": true,
    "seal_fields": [
      "estimate_hash",
      "estimate_version",
      "sealed_at_utc",
      "sealed_by_component",
      "correlation_id"
    ],
    "immutability_rule": "Original estimate is never overwritten; later learning creates feedback version."
  },
  "scoring_contract": {
    "scoring_after_reveal_only": true,
    "dimensions": [
      "identity_accuracy",
