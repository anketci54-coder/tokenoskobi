{
  "era": "ERA34",
  "phase": "ROOT_HYGIENE_GATE_CONTRACT",
  "created_at_utc": "2026-07-06T18:25:00.000000+00:00",
  "source_of_truth": "ERA34 closure checklist contract and repository root hygiene policy",
  "purpose": "Define root directory hygiene gate so generated/control/domain artifacts are placed only under relevant directories, never repository root.",
  "scope": "Control-plane hygiene contract only. No feature work, no CORE upgrade, no root artifact creation.",
  "root_policy": {
    "rule": "Repository root is reserved for existing canonical, boot, kernel and marker files only.",
    "generated_artifacts_allowed_in_root": false,
    "new_domain_artifacts_allowed_in_root": false,
    "new_control_artifacts_allowed_in_root": false,
    "new_canonical_files_allowed": false
  },
  "allowed_root_files": [
    ".TOKENOSKOBI_CLEAN_V1_ROOT",
    ".gitignore",
    "01_INDEX.md",
    "02_MANIFESTO.md",
    "03_ROADMAP.md",
    "04_ALMANAC.md",
    "05_ATLAS.md",
    "06_PROJECT_MASTER_STATE.md",
    "07_PROJECT_HANDOFF.md",
    "NEW_CHAT_PROMPT.md",
    "OKU.md",
    "PROJECT_BOOT.json",
    "PROJECT_HISTORY.json",
    "PROJECT_RUNTIME.json",
    "README.md",
    "TOKENOSKOBI_OS_REGISTRY.json",
    "tokenoskobi_kernel.py"
  ],
  "expected_artifact_locations": {
    "control_plane": "data/control/",
    "early_warning": "data/early_warning/",
    "news": "data/news/ or existing news-specific path",
    "whale": "data/whale/ or existing whale-specific path",
    "risk": "data/risk/ or existing risk-specific path",
    "shadow_lab": "data/shadow_runtime_lab/",
    "real_world_replay": "data/real_world_replay/",
    "reports": "reports/",
    "archives": "archive/ or existing archive-specific path",
    "temporary": "/tmp or ignored temp path"
  },
  "gate_checks": [
    "list_root_files_before_close",
    "compare_root_files_to_allowed_list",
    "fail_on_unexpected_root_file",
    "fail_on_generated_json_at_root_except_existing_allowed_registry",
    "fail_on_report_at_root",
    "fail_on_audit_output_at_root",
    "fail_on_domain_artifact_at_root",
    "confirm_new_artifacts_are_in_relevant_existing_directory"
  ],
  "fail_if": [
    "unexpected_root_file_detected",
    "generated_json_written_to_root",
    "report_written_to_root",
    "audit_output_written_to_root",
    "domain_artifact_written_to_root",
    "new_directory_created_without_checking_existing_structure"
  ],
  "warn_if": [
    "TOKENOSKOBI_OS_REGISTRY_json_dirty_only",
    "legacy_allowed_root_file_missing",
    "artifact_location_requires_new_directory_because_no_existing_relevant_directory_exists"
  ],
  "placement_rule": "Before creating any file, select the closest existing relevant directory. Create a new directory only if no relevant existing directory exists and the purpose is explicit.",
  "guards": {
    "new_era_opened": true,
    "core_upgrade_opened": false,
    "root_files_created": false,
    "new_canonical_file_created": false,
    "live_trade": false,
    "wallet_connection": false,
    "external_api_calls": 0
  },
  "decision": "ERA34_ROOT_HYGIENE_GATE_CONTRACT_DEFINED",
  "next_step": "ERA34_FINAL_GATE_CONTRACT",
  "final_gate": "PASS_ERA34_ROOT_HYGIENE_GATE_CONTRACT"
}
