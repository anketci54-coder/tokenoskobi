      "https://bsc-dataseed.bnbchain.org",
      "https://bsc-dataseed-public.bnbchain.org",
      "https://bsc-dataseed.nariox.org",
      "https://bsc-dataseed.defibit.io"
    ],
    "allowed_hosts": [
