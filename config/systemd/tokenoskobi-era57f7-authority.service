[Unit]
Description=Tokenoskobi ERA57F7 Authority Service

[Service]
User=tokenoskobi-authority
Group=tokenoskobi-authority
SupplementaryGroups=tokenoskobi-authority-ipc
ExecStart=/usr/bin/python3 /usr/local/lib/tokenoskobi-era57f7/authority_service.py
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/tokenoskobi-era57f7/authority
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0007

[Install]
WantedBy=multi-user.target
